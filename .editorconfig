root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_size = 4
max_line_length = 120
# Allow PascalCase composable function names
ktlint_function_naming_ignore_when_annotated_with=Composable

[*.{xml,yml,yaml}]
indent_size = 2

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.gradle.kts]
indent_size = 4
max_line_length = 120

[*.properties]
indent_size = 0
