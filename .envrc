use flake

# Machine-local live-test credentials (SUBSLOTH_API_BASE_URL, SUBSLOTH_LOGIN,
# SUBSLOTH_PASSWORD) live in .env.local, which is gitignored. Loading them from
# here keeps this tracked file free of secrets. Plain KEY=value lines in an
# .envrc are not exported, so this must go through direnv's dotenv loader.
dotenv_if_exists .env.local
watch_file .env.local
