<?xml version="1.0" encoding="utf-8"?>
<!--
  Data extraction rules for Android 12+ device-to-device transfers.
  Credential files and Keystore key material are excluded.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="subsloth_encrypted_credentials.xml" />
        <!-- Tink's wrapped keyset metadata for the EncryptedSharedPreferences master key
             (androidx.security MasterKey default alias). Not itself recoverable without the
             Keystore-resident key, but excluded for defense-in-depth consistency with the
             credentials file above. -->
        <exclude domain="sharedpref" path="_androidx_security_master_key_.xml" />
        <exclude domain="file" path="datastore/" />
        <exclude domain="file" path="downloads/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="subsloth_encrypted_credentials.xml" />
        <!-- Tink's wrapped keyset metadata for the EncryptedSharedPreferences master key
             (androidx.security MasterKey default alias). Not itself recoverable without the
             Keystore-resident key, but excluded for defense-in-depth consistency with the
             credentials file above. -->
        <exclude domain="sharedpref" path="_androidx_security_master_key_.xml" />
        <exclude domain="file" path="datastore/" />
        <exclude domain="file" path="downloads/" />
    </device-transfer>
</data-extraction-rules>
